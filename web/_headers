# Cloudflare Pages / Netlify headers for the Ziran OS web tool.
#
# The two cross-origin-isolation headers are what let the live qemu-wasm boot run
# (SharedArrayBuffer needs an isolated context). GitHub Pages can't set these —
# that's why this project hosts on Cloudflare Pages. Safe to apply site-wide: the
# tour loads no cross-origin resources (v86 and xterm are self-hosted), so nothing
# breaks under COEP: require-corp.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The big emulator payloads change only on a rebuild — cache them hard. If you
# rebuild and need clients to refetch, purge the Cloudflare cache (or hard-reload).
# Emscripten keeps the qemu-system-x86_64.* names (baked into out.js); those are the
# real deployed filenames, NOT out.wasm/out.data — cache the names that exist.
/qemu-system-x86_64.wasm
  Cache-Control: public, max-age=604800
/qemu-system-x86_64.data
  Cache-Control: public, max-age=604800
/qemu-system-x86_64.worker.js
  Cache-Control: public, max-age=604800
/out.js
  Cache-Control: public, max-age=604800
/load.js
  Cache-Control: public, max-age=604800
/v86.wasm
  Cache-Control: public, max-age=604800

# Icons and the social image are stable — cache a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
