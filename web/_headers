# Cloudflare Pages headers for the Ziran OS web tool.

# Site-wide safe defaults.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Cross-origin isolation (COOP + COEP) enables the SharedArrayBuffer the qemu-wasm /
# v86 boot needs. Applied ONLY to the pages that run an emulator — NOT to
# /ctf-remote (no wasm; must load the cross-origin Cloudflare Turnstile widget, which
# COEP would block) and NOT to /replay. Same-origin assets (out.js/.wasm/.data/…)
# load fine under COEP without CORP, so no per-asset CORP is needed.
/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/index.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/ctf
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/ctf.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/qemu-wasm
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/qemu-wasm.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Big emulator payloads change only on a rebuild — cache hard.
/qemu-system-x86_64.wasm
  Cache-Control: public, max-age=604800
/qemu-system-x86_64.data
  Cache-Control: public, max-age=604800
/qemu-system-x86_64.worker.js
  Cache-Control: public, max-age=604800
/out.js
  Cache-Control: public, max-age=604800
/load.js
  Cache-Control: public, max-age=604800
/v86.wasm
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
