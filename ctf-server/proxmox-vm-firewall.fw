# Proxmox VM firewall for the SIMPLER topology: VM on the LAN (vmbr0). Egress to the
# LAN is blocked at the HOST, AND WAN egress is now restricted to an allowlist so the
# tight policy SURVIVES a VM-root `nft flush ruleset`. Copy to
# /etc/pve/firewall/<VMID>.fw on the Proxmox host.
#
# WHY host-level (not in-VM): the attacker's goal is ring-0 in the guest, and we
# assume a possible QEMU escape to VM-root. A rooted VM can flush its OWN nftables —
# so the block that matters MUST live outside the VM. This file is enforced at the
# bridge by the Proxmox host; the VM cannot touch it. THIS is the real boundary.
#
# WHAT CHANGED (egress tightening): policy_out is now DROP (was ACCEPT). WAN egress is
# permitted only to the same destinations the in-VM nftables allows — Cloudflare ranges
# (tunnel + CF-fronted apt mirrors), Canonical ranges (us.archive/security.ubuntu.com +
# ntp.ubuntu.com), and cloud DNS 1.1.1.1/1.0.0.1:53. A flushed guest firewall therefore
# no longer yields OPEN WAN egress — only this allowlist. Mirrors /etc/nftables.conf.
#
# EDIT before applying: the ipfilter IPSET name must match the VM's LAN NIC index on
# the LIVE host (Proxmox names it ipfilter-net0 / ipfilter-net1 per NIC) and hold the
# VM's real IP. Do NOT blind-overwrite the live <VMID>.fw's ipfilter block with a
# guessed NIC index — diff against the live file first.

[OPTIONS]
enable: 1
policy_in: DROP
policy_out: DROP
# Anti-spoof: the VM may only use its assigned MAC/IP (blunts L2/ARP tricks).
ipfilter: 1

[IPSET ipfilter-net1]  # VM LAN NIC — confirm the -net<N> index against the live <VMID>.fw
192.0.2.66             # <- EXAMPLE (RFC5737): replace with the VM's real LAN IP

# WAN egress allowlist — mirrors the in-VM nftables allowlist so a guest-side flush
# cannot open WAN egress. Keep in sync with /etc/nftables.conf on the VM.
[IPSET wan_allow]
# Cloudflare (tunnel + CF-fronted apt mirrors)
173.245.48.0/20
103.21.244.0/22
103.22.200.0/22
103.31.4.0/22
141.101.64.0/18
108.162.192.0/18
190.93.240.0/20
188.114.96.0/20
197.234.240.0/22
198.41.128.0/17
162.158.0.0/15
104.16.0.0/13
104.24.0.0/14
172.64.0.0/13
131.0.72.0/22
# Canonical (us.archive.ubuntu.com, security.ubuntu.com, ntp.ubuntu.com)
91.189.88.0/21
185.125.188.0/22

[RULES]
# --- INBOUND: admin/Claude SSH only; everything else -> policy_in: DROP ---
IN ACCEPT -source 192.0.2.0/24 -p tcp -dport 22 -log nolog   # <- EXAMPLE (RFC5737): your admin LAN/workstation

# --- OUTBOUND: first-match top-down; the rest falls through to policy_out: DROP ---
# 1) cloud DNS (matches the in-VM 1.1.1.1/1.0.0.1:53 allow)
OUT ACCEPT -dest 1.1.1.1 -p udp -dport 53 -log nolog
OUT ACCEPT -dest 1.0.0.1 -p udp -dport 53 -log nolog
OUT ACCEPT -dest 1.1.1.1 -p tcp -dport 53 -log nolog
OUT ACCEPT -dest 1.0.0.1 -p tcp -dport 53 -log nolog
# 2) WAN allowlist (Cloudflare + Canonical), all ports — carries the tunnel, apt, NTP
OUT ACCEPT -dest +wan_allow -log nolog
# 3) explicit LAN drop (belt-and-suspenders; policy_out: DROP already covers it)
OUT DROP -dest 192.168.0.0/16 -log nolog
OUT DROP -dest 10.0.0.0/8 -log nolog
OUT DROP -dest 172.16.0.0/12 -log nolog
# everything else (arbitrary WAN) -> policy_out: DROP
