# Hardened systemd unit for the Tier-2 CTF bridge.
# Installed to /etc/systemd/system/ by setup-vm.sh.
[Unit]
Description=Ziran OS Tier-2 CTF bridge (WebSocket -> ephemeral QEMU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctf
Group=ctf
WorkingDirectory=/opt/ziran
ExecStart=/usr/bin/node /opt/ziran/bridge.mjs
Restart=on-failure
RestartSec=2

# --- config (override in /etc/systemd/system/ctf-bridge.service.d/*.conf) ---
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=KERNEL=/opt/ziran/kernel-v86.bin
Environment=MAX_CONCURRENT=12
Environment=MAX_PER_IP=2
Environment=SESSION_MS=180000
Environment=IDLE_MS=90000
Environment=RATE_MAX=10
Environment=HOURLY_BUDGET=1000
# Optional human gate: set to your Cloudflare Turnstile SECRET key to require a
# challenge before any session spawns. Leave empty to disable.
Environment=TURNSTILE_SECRET=
# Kill switch: `touch /opt/ziran/PAUSED` to stop accepting new sessions (no restart).
Environment=PAUSE_FILE=/opt/ziran/PAUSED

# --- sandboxing the bridge process itself (it still spawns QEMU) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ziran
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Backstop cap on the whole service tree (node + every QEMU). Per-instance caps come
# from `systemd-run --user` in bridge.mjs (needs `loginctl enable-linger ctf`, done by
# setup-vm.sh); this tree cap bounds the box even if that falls back to `caps=tree-only`.
# Sized below total VM RAM (~4 GiB) so a runaway fleet can't OOM the host itself.
MemoryMax=3G
CPUQuota=350%
TasksMax=512

[Install]
WantedBy=multi-user.target
